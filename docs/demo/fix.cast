[23.880487, "o", "\u001b[91m--- a/auth/tokens.py\u001b[0m\r\r\n\u001b[92m+++ b/auth/tokens.py\u001b[0m\r\r\n\u001b[1;95m@@ -30,7 +30,7 @@\u001b[0m\r\r\n\u001b[90m \u001b[0m        token = self._tokens.get(token_id)\r\r\n\u001b[90m \u001b[0m        if token is None:\r\r\n\u001b[90m \u001b[0m            return False\r\r\n\u001b[91m-        return token.expires_at > 0  # BUG: expiry is never compared with the current time\u001b[0m\r\r\n\u001b[92m+        return token.expires_at > time.time()\u001b[0m\r\r\n\u001b[90m \u001b[0m\r\r\n\u001b[90m \u001b[0m    def revoke(self, token_id: str) -> None:\r\r\n\u001b[90m \u001b[0m        self._tokens.pop(token_id, None)\r\r\n\r\r\nApply changes to 1 file(s)? [y]es / [n]o [n]:"]
