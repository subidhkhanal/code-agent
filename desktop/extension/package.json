{
	"name": "code-agent",
	"displayName": "Code Agent",
	"description": "Agents for planning, designing, coding, reviewing and testing, built into Code Agent.",
	"version": "0.1.0",
	"publisher": "code-agent",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": ["AI", "Other"],
	"main": "./dist/extension.js",
	"activationEvents": ["onStartupFinished"],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{ "id": "codeAgent", "title": "Agents", "icon": "media/agents.svg" }
			]
		},
		"views": {
			"codeAgent": [
				{ "id": "codeAgent.agents", "name": "Agents" }
			]
		},
		"commands": [
			{ "command": "codeAgent.newAgent", "title": "New Agent…", "category": "Code Agent", "icon": "$(add)" }
		],
		"menus": {
			"view/title": [
				{ "command": "codeAgent.newAgent", "when": "view == codeAgent.agents", "group": "navigation" }
			]
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.100.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.8.0"
	}
}
